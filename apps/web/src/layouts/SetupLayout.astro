---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import { tServer } from '../lib/i18n/server';

interface Props {
  title?: string;
  titleKey?: string;
}

const { title, titleKey } = Astro.props;
const pageTitle = titleKey ? tServer(Astro.locals.locale, titleKey) : title;
const metaDescription = tServer(Astro.locals.locale, 'layout.metaDescriptionSetup');
const setupTagline = tServer(Astro.locals.locale, 'titles.setup');
---

<!DOCTYPE html>
<html lang={Astro.locals.locale ?? 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle} | Colonyn RMM</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background antialiased">
    <div class="flex min-h-screen items-center justify-center px-4 py-12">
      <div class="w-full max-w-3xl space-y-8">
        <div class="text-center">
          <div class="mx-auto flex h-9 w-9 items-center justify-center rounded-lg bg-primary/15">
            <img src="/brand-logo.svg" width="18" height="18" alt="Colonyn" class="object-contain" />
          </div>
          <h1 class="mt-3 text-xl font-bold tracking-tight" aria-label="Colonyn">colony<span class="text-primary">n</span></h1>
          <p class="mt-1 text-sm text-muted-foreground">{setupTagline}</p>
        </div>

        <slot />
      </div>
    </div>
  </body>
</html>
