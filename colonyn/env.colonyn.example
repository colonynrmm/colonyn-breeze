# --- Colonyn additions to /opt/breeze/.env -----------------------------------
# Generate each secret with:  openssl rand -hex 32

# Where the Colonyn source tree lives on this server, and the image tag to build.
COLONYN_SRC=/opt/colonyn-breeze
COLONYN_IMAGE_TAG=0.123.0-colonyn.4

# Odoo -> Bridge authentication (copy both values into the Odoo module settings).
COLONYN_BRIDGE_TOKEN=
COLONYN_BRIDGE_HMAC_SECRET=

# Public name of the bridge and who may call it.
# Add a DNS A record for this name pointing at THIS server before starting.
# Odoo on the same LAN: allow its LAN address, and on the Odoo server map
# bridge.colonyn.com to this server's LAN IP (/etc/hosts or Odoo's extra_hosts).
COLONYN_BRIDGE_DOMAIN=bridge.colonyn.com
COLONYN_BRIDGE_ALLOWED_IPS=10.0.0.5/32

# Bridge -> Odoo over the LAN (avoids hairpin NAT through the router).
COLONYN_ODOO_LAN_HOST=www.example.com:10.0.0.5

# Breeze -> Bridge partner hooks (device-limit etc.).
PARTNER_HOOKS_URL=http://colonyn-bridge:3010/hooks
PARTNER_HOOKS_SECRET=

# Bridge -> Odoo events (leave empty until the Odoo controller exists).
COLONYN_ODOO_WEBHOOK_URL=https://www.colonyn.com/colonyn/webhook/breeze
COLONYN_ODOO_WEBHOOK_SECRET=

# Copy the e-mail templates you saved in Settings > Partner > Email templates
# of this partner (your own "Default Partner") to every new customer.
# Find the id with:  docker compose exec -T postgres psql -U breeze -d breeze -Atc "select id from partners where name='Default Partner'"
COLONYN_TEMPLATE_PARTNER_ID=

# Shown as the inviter in the activation e-mail.
COLONYN_INVITER_NAME=Tim Colonyn

# Upgrade page shown when a tenant hits its device or technician quota or opens a module outside its plan.
COLONYN_UPGRADE_URL=https://www.colonyn.com/my/rmm

# Plan modules and technician limit. "off" lets every tenant use every module (emergency switch).
COLONYN_ENTITLEMENTS=on
